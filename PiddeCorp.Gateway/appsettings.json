{
  "Redis": {
    "ConnectionString": "piddecorp-redis:6379"
  },
  "Gateway": {
    "ShellRedirectUrl": "http://localhost:5175"
  },
  "ReverseProxy": {
    "Routes": {
      "taskmanager-api": {
        "ClusterId": "taskmanager-api",
        "AuthorizationPolicy": "RequireGatewaySession",
        "Match": {
          "Path": "/taskmanager/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/taskmanager" }
        ]
      },
      "module2-api": {
        "ClusterId": "module2-api",
        "AuthorizationPolicy": "RequireGatewaySession",
        "Match": {
          "Path": "/module2/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/module2" }
        ]
      }
    },
    "Clusters": {
      "taskmanager-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://taskmanager.api:8080/"
          }
        }
      },
      "module2-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://module2.api:8080/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}