@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Redirecting to portal...</title>
</head>
<body onload="document.forms[0].submit()" style="font-family: sans-serif; max-width: 420px; margin: 80px auto;">
    <p>Redirecting you to the portal...</p>

    <!--
        This is a genuine top-level form POST, not a fetch/XHR call. That
        matters: because it's a full-page navigation, there's no CORS to
        configure, and the token never sits in a URL where it could leak
        into browser history or access logs. See ADR-003, decision 3.
    -->
    <form method="post" action="@ViewBag.GatewayUrl">
        <input type="hidden" name="token" value="@ViewBag.Token" />
        <noscript>
            <button type="submit">Continue to portal</button>
        </noscript>
    </form>
</body>
</html>
