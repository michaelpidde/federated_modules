@using System.Linq
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>LegacySite - Login</title>
</head>
<body style="font-family: sans-serif; max-width: 420px; margin: 80px auto;">
    <h2>LegacySite</h2>
    <p style="color: #666;">This is a fake stand-in for the real site. Any username works; password is ignored.</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <p style="color: #b00020;">@ViewData.ModelState[""]?.Errors.FirstOrDefault()?.ErrorMessage</p>
    }

    <form method="post" action="/Account/Login">
        <p>
            <label>Username<br />
                <input type="text" name="username" autofocus />
            </label>
        </p>
        <p>
            <label>Password<br />
                <input type="password" name="password" />
            </label>
        </p>
        <button type="submit">Log in</button>
    </form>
</body>
</html>
